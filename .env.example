# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend development configuration
API_PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-session-secret"
FILE_ENCRYPTION_KEY="replace-with-a-long-random-file-key"
DATA_DIR="./data"
MAX_UPLOAD_BYTES=524288000

# Real federated-learning worker
PYTHON_BIN="python3"

# AWS values are intentionally optional for local development. Configure these
# through the deployment environment or Secrets Manager when AWS is provisioned.
AWS_REGION="ap-south-1"
AWS_S3_DATA_BUCKET=""
AWS_S3_MODEL_BUCKET=""
AWS_S3_BACKUP_BUCKET=""
AWS_KMS_KEY_ID=""
AWS_RDS_DATABASE_URL=""
AWS_RDS_SECRET_ARN=""
AWS_RDS_PROXY_ENDPOINT=""
AWS_RDS_DATABASE="collaborative_learning"
# Optional direct PostgreSQL connection for local migrations or non-AWS deployments.
PLATFORM_DATABASE_URL=""
AWS_COGNITO_USER_POOL_ID=""
AWS_COGNITO_CLIENT_ID=""
AWS_SAGEMAKER_ROLE_ARN=""
AWS_SAGEMAKER_TRAINING_IMAGE=""
AWS_SAGEMAKER_INSTANCE_TYPE="ml.m5.large"
AWS_CLOUDWATCH_METRICS="true"
